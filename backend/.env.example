DATABASE_URL=postgresql+asyncpg://scene:scene@localhost:5432/scene

STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/storage

# Fill these in once you have a Cloudflare R2 (or other S3-compatible) bucket.
# Required before job dispatch to the RunPod GPU worker will work.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Fill these in once you've created a RunPod account and deployed worker/.
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
