# The only required setting for temporary remote compute.
RUNPOD_API_KEY=

# All permanent uploads, frames, geometry, and viewer artifacts remain here.
STORAGE_LOCAL_PATH=./data/storage
RECONSTRUCTION_QUALITY_PROFILE=high

# Temporary pod defaults use the pinned project image.
RUNPOD_IMAGE=ghcr.io/yusupildan-wq/scene-reconstruction-gpu:v3-pt24-cu124-gsplat153
# RTX 4090 is the golden GPU (used by the verified IMG_1705 run); the rest are
# same-quality (>=24GB, Ampere/Ada) fallbacks tried by RunPod when 4090 Community
# Cloud capacity is briefly exhausted, which otherwise fails pod creation outright.
RUNPOD_GPU_TYPE_IDS=NVIDIA GeForce RTX 4090,NVIDIA L40S,NVIDIA RTX 6000 Ada Generation,NVIDIA RTX A6000
RUNPOD_CLOUD_TYPE=COMMUNITY
# Hard cost guard: terminate a pod that never exposes its network after 10 minutes.
RUNPOD_STARTUP_TIMEOUT_SECONDS=600

# Configure these only for native Local NVIDIA mode.
LOCAL_PROJECT_ROOT=..
LOCAL_VGGT_ROOT=../external/vggt
LOCAL_GSPLAT_ROOT=../external/gsplat
LOCAL_VGGT_PYTHON=../.venvs/vggt/Scripts/python.exe
LOCAL_GSPLAT_PYTHON=../.venvs/gsplat/Scripts/python.exe
MINIMUM_VRAM_GB=24
